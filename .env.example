# Kare Docker — configuration template
# Copy to .env and edit before running docker compose up.

# ── Profile ────────────────────────────────────────────────────────────────────
# "ollama"  — include built-in Ollama LLM server (~10 GB image download).
#             Remove if you have your own Ollama/vLLM/cloud LLM running elsewhere.
# "medium"  — include BGE-M3 embedding service (vector search, ~3 GB).
# "full"    — include BGE-M3 + voice bridge (STT/TTS).
# Combine with commas. Run setup.sh (Linux/macOS) or setup.ps1 (Windows) to auto-detect.
COMPOSE_PROFILES=ollama,medium

# ── Version and install path ───────────────────────────────────────────────────
# Written by setup.sh / setup.ps1; after that the in-app updater (Maintenance page) manages them.
# KTSB_VERSION   — release whose images run (e.g. v1.10.0). Empty = the :latest images.
# KTSB_HOME      — this install folder as the Docker engine sees it.
# KTSB_HOME_HOST — this install folder as this computer sees it (differs only on Windows).
# KTSB_VERSION=
# KTSB_HOME=
# KTSB_HOME_HOST=

# ── Domain for HTTPS (Caddy) ──────────────────────────────────────────────────
# Your DuckDNS domain, e.g. kaare.duckdns.org
# Caddy automatically obtains a Let's Encrypt certificate.
# Without a domain: use "localhost" for local HTTP access.
KAARE_DOMAIN=localhost

# ── Web search (SearXNG, built in) ───────────────────────────────────────────────
# Secret for SearXNG's own cookies/links (internal only). Any random string, e.g.:
#   openssl rand -hex 32
SEARXNG_SECRET=

# ── HuggingFace (optional, for image generation and cloud LLM) ───────────────
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Brave Search (optional, for web search) ───────────────────────────────────
# BRAVE_API_KEY=BSAxxxxxxxxxxxxxxxxxxxxxxxxx

# ── WireGuard VPN (optional — add "vpn" to COMPOSE_PROFILES to enable) ────────
# Your public hostname or IP. DuckDNS recommended — can reuse KAARE_DOMAIN value.
# WG_HOST=mykaare.duckdns.org
# Generate hash: docker run --rm ghcr.io/wg-easy/wg-easy:15 wg-easy --hash YourPassword
# WG_PASSWORD_HASH=$$2a$$12$$...   (note: $$ escapes $ in .env files)
