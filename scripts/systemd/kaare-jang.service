[Unit]
Description=KTSB inner voice – Jang (slow inner voice): the model role «jang» (Settings → LLM/Models), or the model in-process
After=network.target kaare.service kaare-jing.service

[Service]
UMask=0002
User=kaare
WorkingDirectory=/kaare
Environment=PYTHONPATH=/kaare
Environment=PYTHONUNBUFFERED=1
ExecStart=/kaare/venv/bin/python3 /kaare/kaare_inner_voices.py --voice jang
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
