# KTSB updater (P57): docker CLI + compose plugin, Python 3 (stdlib only) and cosign — nothing else.
# Everything is pinned: this container holds the keys to the house (docker.sock).
FROM docker:29.9.0-cli-alpine3.24 AS dockercli

FROM alpine:3.24

# hadolint ignore=DL3018
RUN apk add --no-cache python3 ca-certificates

COPY --from=dockercli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=dockercli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
ADD --chmod=0755 --checksum=sha256:4629c757b7618056f8ddd7e2625ae9fdd94c0372a65049520bc7d9df9efc7f71 \
    https://github.com/sigstore/cosign/releases/download/v3.1.3/cosign-linux-amd64 /usr/local/bin/cosign

ARG KTSB_VERSION=dev
ENV KTSB_UPDATER_VERSION=${KTSB_VERSION} \
    PYTHONUNBUFFERED=1

WORKDIR /opt/ktsb-updater
COPY services/updater/updater.py .

ENTRYPOINT ["python3", "/opt/ktsb-updater/updater.py"]
