FROM python:3.12-slim

WORKDIR /kaare/services/embedding

COPY services/embedding/requirements.txt services/embedding/constraints.txt ./

# torch CPU-only (~200 MB vs ~2 GB for the default CUDA build)
RUN pip install --no-cache-dir torch -c constraints.txt --index-url https://download.pytorch.org/whl/cpu

# Separate layer on purpose: the large torch layer above stays cached when requirements change.
# hadolint ignore=DL3059
RUN pip install --no-cache-dir -r requirements.txt -c constraints.txt

COPY kaare_core/ /kaare/kaare_core/
COPY configs_default/ /kaare/configs_default/
COPY services/embedding/server.py .

ENV PYTHONPATH=/kaare

CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "11446"]
